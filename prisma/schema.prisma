generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Suite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  briefEn          String
  briefFr          String
  descriptionEn    String   @default("")
  descriptionFr    String   @default("")
  area      String
  view      String
  rate      String
  // Authoritative nightly rate charged online, in MAD minor units (centimes).
  // `rate` above stays the marketing/display string (often shown in €). CMI
  // settles in MAD (currency 504), so this integer is the single source of
  // truth the server uses to compute the amount. 0 = not chargeable online.
  rateMadCents     Int      @default(0)
  imageKind String   @default("sunset")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  hours     String
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  n         String
  nameEn    String
  nameFr    String
  when      String
  who       String
  ledeEn    String
  ledeFr    String
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String   @default("")
  ledeFr    String   @default("")
  copyEn    String
  copyFr    String
  capacity  String
  venueEn   String?  @default("Full kasbah")
  venueFr   String?  @default("Kasbah complète")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SunsetParty {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  capacity  String
  season    String
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DayPass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String   @default("")
  ledeFr    String   @default("")
  copyEn    String   @default("")
  copyFr    String   @default("")
  hours     String   @default("")
  price     String   @default("")
  currency  String   @default("€")
  // Authoritative online charge in MAD minor units (centimes). `price` and
  // `currency` above stay the marketing/display strings (usually EUR); CMI
  // settles in MAD (currency 504), so these integers are what the server
  // actually charges. 0 = this pass cannot be paid online (the booking form
  // falls back to sending an enquiry).
  priceMadCents      Int  @default(0) // per adult
  childPriceMadCents Int  @default(0) // per child (0 = children not charged)
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transfer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  duration  String
  price     String
  // Authoritative online charge in MAD minor units (centimes), flat per
  // vehicle/trip. `price` above stays the marketing string. 0 = not payable
  // online (the page keeps its enquiry CTA).
  priceMadCents Int  @default(0)
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  table     String   @default("")
  checkin   String   @default("")
  checkout  String   @default("")
  guests    String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Treatment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameEn    String
  nameFr    String
  duration  String
  price     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guestName String
  email     String   @default("")
  phone     String   @default("")
  suite     String
  checkIn   String
  checkOut  String
  nights    Int      @default(1)
  guests    Int      @default(1)
  total     String   @default("")
  status    String   @default("Pending")
  notes     String   @default("")
  // At most one order in practice (guaranteed by Order.bookingRef); a list only
  // because the foreign key on Order is not itself unique.
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// A booking for a paid-online service that is not a room stay: a day pass or a
// transfer. Kept separate from Reservation (no check-in/check-out, no suite)
// but wired into the same Order / payment machinery.
enum ServiceKind {
  DAY_PASS
  TRANSFER
}

model ServiceBooking {
  id        String      @id @default(auto()) @map("_id") @db.ObjectId
  kind      ServiceKind
  // The DayPass / Transfer this booking is for. `itemId` is the join used to
  // recompute the price server-side; slug and name are snapshots so a later
  // rename or deletion doesn't erase what was sold.
  itemId    String      @db.ObjectId
  itemSlug  String
  itemName  String
  date      String   // YYYY-MM-DD
  time      String   @default("")
  // For a transfer these are passengers rather than day-pass guests.
  adults    Int      @default(1)
  children  Int      @default(0)
  // Transfers only.
  pickup    String   @default("")
  dropoff   String   @default("")
  guestName String
  email     String
  phone     String   @default("")
  notes     String   @default("")
  // Display snapshot of what was quoted; the charged amount lives on the Order.
  total     String   @default("")
  status    String   @default("Pending") // Pending | Confirmed | Cancelled
  // At most one order in practice (guaranteed by Order.bookingRef); a list only
  // because the foreign key on Order is not itself unique.
  orders    Order[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ─── CMI online payment ──────────────────────────────────────────────────────

// Deliberately NO "failed" status: per the CMI spec, failed payment attempts
// must not change the order status. The order stays PENDING and every failed
// attempt is recorded in PaymentCallback instead.
enum OrderStatus {
  PENDING
  PAID
  UNDER_RECONCILIATION
  CANCELLED
  REFUNDED
  PARTIALLY_REFUNDED
}

model Order {
  id       String      @id @default(auto()) @map("_id") @db.ObjectId
  // The CMI merchant order id: alphanumeric only, max 64 chars. Reused across
  // failed retries of the same order; a new oid is minted only for a new order
  // or after this oid has been consumed by a successful transaction.
  oid      String      @unique
  status   OrderStatus @default(PENDING)

  // "One order per thing sold", enforced by a unique index. It has to live on a
  // field that is ALWAYS set: MongoDB treats a missing/null value as a value,
  // so a unique index on an optional foreign key would let only ONE order exist
  // without it. Format: "res:<reservationId>" for a stay, "svc:<serviceBookingId>"
  // for a day pass / transfer.
  bookingRef String     @unique

  // Authoritative charged amount, MAD minor units (centimes). Currency is the
  // ISO-4217 numeric code sent to CMI ("504" = MAD).
  amount   Int
  currency String      @default("504")

  // Optional display currency (what the customer sees, e.g. EUR). When present
  // and different from MAD, initiate sends `amountCur` / `symbolCur` to CMI.
  displayAmount   Int?
  displayCurrency String?
  displaySymbol   String?

  // Mirrors the status shown in the CMI Merchant Center for this order:
  // PRE = pre-authorized, POST = captured, VOID = cancelled auth, RFND = refunded.
  cmiStatus   String?

  lang        String  @default("en")
  description String  @default("")

  customerName  String
  customerEmail String
  customerPhone String @default("")

  // Payment data captured from the authoritative host-to-host callback.
  transId        String?
  authCode       String?
  hostRefNum     String?
  acqStan        String?
  maskedPan      String?
  cardBrand      String?
  trxDate        String?
  mdStatus       String?
  txstatus       String?
  procReturnCode String?

  postAuthRequestedAt DateTime?
  postAuthConfirmedAt DateTime?
  paidAt              DateTime?
  fulfilledAt         DateTime?

  // Exactly one of these is set: a room stay or a day-pass/transfer booking.
  // Deliberately NOT @unique — see bookingRef above, which is the uniqueness
  // key. These are plain foreign keys, for navigation only.
  reservationId String?      @db.ObjectId
  reservation   Reservation? @relation(fields: [reservationId], references: [id])

  serviceBookingId String?         @db.ObjectId
  serviceBooking   ServiceBooking? @relation(fields: [serviceBookingId], references: [id])

  callbacks PaymentCallback[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model PaymentCallback {
  id      String  @id @default(auto()) @map("_id") @db.ObjectId
  orderId String? @db.ObjectId
  order   Order?  @relation(fields: [orderId], references: [id])
  oid     String

  // Idempotency key: TransId when present, otherwise a payload fingerprint.
  // A unique index guarantees a duplicate delivery cannot be persisted twice.
  fingerprint String  @unique
  transId     String?

  // Which channel delivered this: the authoritative host-to-host callback, or
  // the browser return on okUrl / failUrl.
  channel String @default("callback")

  hashValid      Boolean  @default(false)
  amountMatched  Boolean?
  procReturnCode String?
  responseCode   String? // CMI `Response` field: Approved / Declined / Error
  mdStatus       String?
  txstatus       String?
  errCode        String?
  errMsg         String?
  // Exact body returned to CMI (ACTION=POSTAUTH | APPROVED | FAILURE) or the
  // action taken for a browser return.
  responseSent String?
  raw          Json

  createdAt DateTime @default(now())
}

model Guest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @default("")
  phone     String   @default("")
  country   String   @default("")
  stays     Int      @default(0)
  vip       Boolean  @default(false)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An admin-declared closure: a service (or the whole property) is not bookable
// for a date range. Enforced server-side by every booking entry point.
model AvailabilityBlock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // What this block closes:
  //   serviceType = ""      → the entire property (every service)
  //   serviceType = "suite" → suites; serviceId = "" means every suite,
  //                           otherwise that one suite's id
  // serviceType values are the slugs in lib/services.ts (suite, restaurant,
  // day-pass, sunset-party, event, experience, transfer, treatment).
  serviceType String   @default("")
  serviceId   String   @default("")
  // Human label captured at creation (e.g. "Suite La Khoutoubia", "All suites",
  // "Entire property") so the admin list stays readable if the item is renamed.
  serviceName String   @default("")
  // Inclusive range of blocked dates, YYYY-MM-DD. A booking conflicts with the
  // block when it occupies any date in [startDate, endDate].
  startDate   String
  endDate     String
  reason      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique @default("default")
  partiesEnabled  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
