generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Suite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  briefEn          String
  briefFr          String
  descriptionEn    String   @default("")
  descriptionFr    String   @default("")
  area      String
  view      String
  rate      String
  imageKind String   @default("sunset")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  hours     String
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  n         String
  nameEn    String
  nameFr    String
  when      String
  who       String
  ledeEn    String
  ledeFr    String
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String   @default("")
  ledeFr    String   @default("")
  copyEn    String
  copyFr    String
  capacity  String
  venueEn   String?  @default("Full kasbah")
  venueFr   String?  @default("Kasbah complète")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SunsetParty {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  capacity  String
  season    String
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DayPass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String   @default("")
  ledeFr    String   @default("")
  copyEn    String   @default("")
  copyFr    String   @default("")
  hours     String   @default("")
  price     String   @default("")
  currency  String   @default("€")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transfer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  duration  String
  price     String
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ContactMessage {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String
  phone     String   @default("")
  subject   String
  message   String
  table     String   @default("")
  checkin   String   @default("")
  checkout  String   @default("")
  guests    String   @default("")
  read      Boolean  @default(false)
  createdAt DateTime @default(now())
}

model Treatment {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  nameEn    String
  nameFr    String
  duration  String
  price     String
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Reservation {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  guestName String
  suite     String
  checkIn   String
  checkOut  String
  nights    Int      @default(1)
  guests    Int      @default(1)
  total     String   @default("")
  status    String   @default("Pending")
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// An admin-defined closure that removes a reservable service from booking for a
// date range, while other dates stay bookable. Used for maintenance, private
// buy-outs, seasonal closures, etc.
model AvailabilityBlock {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  // What this block closes:
  //   serviceType = ""      → the entire property (every service)
  //   serviceType = "suite" → suites; serviceId = "" means every suite,
  //                           otherwise that one suite's id
  // serviceType values are the slugs in lib/services.ts (suite, restaurant,
  // day-pass, sunset-party, event, experience, transfer, treatment).
  serviceType String   @default("")
  serviceId   String   @default("")
  // Human label captured at creation (e.g. "Suite La Khoutoubia", "All suites",
  // "Entire property") so the admin list stays readable if the item is renamed.
  serviceName String   @default("")
  // Inclusive range of blocked nights, YYYY-MM-DD. A stay conflicts with the
  // block when it occupies any night in [startDate, endDate].
  startDate   String
  endDate     String
  reason      String   @default("")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Guest {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  name      String
  email     String   @default("")
  phone     String   @default("")
  country   String   @default("")
  stays     Int      @default(0)
  vip       Boolean  @default(false)
  notes     String   @default("")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SiteSettings {
  id              String   @id @default(auto()) @map("_id") @db.ObjectId
  key             String   @unique @default("default")
  partiesEnabled  Boolean  @default(true)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}
