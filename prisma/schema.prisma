generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("MONGODB_URL")
}

model AdminUser {
  id           String   @id @default(auto()) @map("_id") @db.ObjectId
  username     String   @unique
  passwordHash String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model Suite {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  briefEn          String
  briefFr          String
  descriptionEn    String   @default("")
  descriptionFr    String   @default("")
  area      String
  view      String
  rate      String
  // Authoritative nightly rate charged online, in MAD minor units (centimes).
  // `rate` above stays the marketing/display string (often shown in €). CMI
  // settles in MAD (currency 504), so this integer is the single source of
  // truth the server uses to compute the amount. 0 = not chargeable online.
  rateMadCents     Int      @default(0)
  imageKind String   @default("sunset")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Restaurant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  hours     String
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Experience {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  n         String
  nameEn    String
  nameFr    String
  when      String
  who       String
  ledeEn    String
  ledeFr    String
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Event {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String   @default("")
  ledeFr    String   @default("")
  copyEn    String
  copyFr    String
  capacity  String
  venueEn   String?  @default("Full kasbah")
  venueFr   String?  @default("Kasbah complète")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SunsetParty {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  capacity  String
  season    String
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model DayPass {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String   @default("")
  ledeFr    String   @default("")
  copyEn    String   @default("")
  copyFr    String   @default("")
  hours     String   @default("")
  price     String   @default("")
  currency  String   @default("€")
  heroImageUrl String? @default("")
  imageUrl  String   @default("")
  images    String[] @default([])
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Transfer {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  slug      String   @unique
  nameEn    String
  nameFr    String
  ledeEn    String
  ledeFr    String
  copyEn    String
  copyFr    String
  duration  String
  price     String
  imageUrl  String   @default("")
  active    Boolean  @default(true)
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
